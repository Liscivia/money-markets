# Optional on Vercel. Leave unset to use public providers directly with temporary caching.
# Set BOTH using Vercel server-side environment settings, never VITE_* variables.
# MONEY_MARKETS_COLLECTOR_URL=https://your-collector-host.example
# MONEY_MARKETS_COLLECTOR_TOKEN=<32 random bytes encoded as 64 hexadecimal characters>

# Optional local collector settings (the token file must exist and be kept private).
# COLLECTOR_STATE_DIR=.data/collector
# COLLECTOR_TOKEN_FILE=.data/collector-token
# COLLECTOR_PORT=3102
